# NEAR Intents 1Click API (https://docs.near-intents.org/near-intents/integration/distribution-channels/1click-api)
# Works without a key. Keyless quotes include a 0.2% 1Click fee (visible as appFees in each quote).
# See the NEAR Intents docs for getting an API key (preferred) or a JWT (older scheme).
ONECLICK_API_KEY=
ONECLICK_JWT=

# Optional backup swap route: ChangeNOW (https://changenow.io/for-partners), used automatically only while
# 1Click is unreachable. Fixed-rate orders on popular assets; ZEC is paid to transparent (t1…) addresses only,
# and ChangeNOW's terms exclude the US, UK and India. Partner fee is set in the ChangeNOW partner dashboard.
# Without a key there's no backup: swaps pause while 1Click is down.
CHANGENOW_API_KEY=

# Optional: your own service fee, paid to a NEAR account inside Intents.
# ZCAN_FEE_BPS is in basis points (50 = 0.5%). Leave empty for no fee.
ZCAN_FEE_RECIPIENT=
ZCAN_FEE_BPS=

# Override only for testing.
# ONECLICK_BASE_URL=https://1click.chaindefuser.com

# Privacy agents run on any OpenAI-compatible chat API: Zcan's own model (deploy/model/README.md), an
# outside provider, or DeepSeek by default. Without a key the agent pages still load and explain that
# agents aren't switched on.
#
# Zcan's own model on Modal (see deploy/model/README.md):
#   AI_BASE_URL=https://<workspace>--zcan-model-model.us-east.modal.direct/v1
#   AI_API_KEY=wk-….ws-…            (the Modal proxy token)
#   AI_MODEL=zcan-privacy-model
#   AI_REASONING_EFFORT=medium      (gpt-oss: low | medium | high)
#   NEXT_PUBLIC_AI_SELF_HOSTED=true
#   NEXT_PUBLIC_AI_MODEL_NAME=Zcan Privacy Model
#   NEXT_PUBLIC_AI_HOST=Modal       (listed on Transparency as the GPU host)
#   NEXT_PUBLIC_AI_HOST_POLICY=     (its privacy policy URL)
#
# An outside provider (Together, Fireworks, …): AI_API_KEY, AI_BASE_URL, AI_MODEL, plus
#   NEXT_PUBLIC_AI_PROVIDER=Together AI          (shown everywhere: who receives what people type)
#   NEXT_PUBLIC_AI_PROVIDER_POLICY=https://…     (its privacy policy)
# DeepSeek: just AI_API_KEY (https://platform.deepseek.com).
#
# The model must support tool calling (web search) and JSON output. Plans ask for JSON with a schema
# (json_schema), or json_object for DeepSeek; override with AI_JSON_MODE.
# NEXT_PUBLIC_* values are build-time: redeploy after changing them.
AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# AI_PLAN_MODEL=          # optional faster model for plans (defaults to AI_MODEL)
#
# Older names still work as fallbacks: DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL, DEEPSEEK_MODEL, DEEPSEEK_PLAN_MODEL.

# Optional: live web search for the agents (https://tavily.com). Without it, agents
# work from the model's own knowledge and say that live sources weren't checked.
TAVILY_API_KEY=

# Optional: "Pay with wallet" on order pages (WalletConnect / Reown AppKit).
# Free project ID at https://cloud.reown.com — add your domain to its allowlist.
# Build-time value: redeploy after changing it. Leave empty to hide the button.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional: opt-in training data for your own model. Readers can share an anonymized agent run
# after seeing it (never automatically; Exposure Scout, Data Broker Remover and Phishing Checker are never shareable).
# Needs a Redis REST store — create one under Vercel → Storage → Upstash (Redis); it sets
# KV_REST_API_URL / KV_REST_API_TOKEN (UPSTASH_REDIS_REST_URL / _TOKEN also work).
# TRAINING_SIGNING_SECRET: 32+ random characters (e.g. `openssl rand -base64 48`).
# TRAINING_ADMIN_TOKEN: 24+ random characters; protects GET /api/training/export (JSONL for fine-tuning)
# and GET /api/training/stats (counts only). Both answer 404 without it.
TRAINING_SIGNING_SECRET=
TRAINING_ADMIN_TOKEN=

# Optional: site-wide daily caps on agent plans and runs (needs the Redis store above).
# Defaults: 1000 plans and 300 runs per UTC day, plus per-IP hourly limits shared across instances.
# AGENT_DAILY_PLAN_CAP=1000
# AGENT_DAILY_RUN_CAP=300

# Crash reports: browsers and the server send scrubbed errors to /api/errors (no IP, cookies or query
# strings; visitors can switch it off in Settings → Privacy). They're kept 14 days in the Redis store above;
# without a store they only go to the server log. Read them with
#   curl -H "Authorization: Bearer $TRAINING_ADMIN_TOKEN" https://<site>/api/errors
# ERROR_DAILY_CAP=5000

# Optional: cookieless usage counts (page views and feature use) via Plausible or Umami. Events go
# through Zcan's own /api/event — no third-party script on the page — and only carry the page path
# (ids and query removed), the referring site and a feature name. The visitor's IP and user agent are
# forwarded so the provider can filter bots. Visitors can switch it off in Settings → Privacy, and it
# starts off for browsers sending Do Not Track or Global Privacy Control.
# NEXT_PUBLIC_ANALYTICS=plausible     # or: umami
# ANALYTICS_SITE=zcan.dev             # Plausible: the site's domain · Umami: the website id
# ANALYTICS_HOST=                     # only for a self-hosted instance
# ANALYTICS_DOMAIN=zcan.dev           # Umami: hostname reported for page views

# Referrals (only when ZCAN_FEE_BPS and ZCAN_FEE_RECIPIENT are set): a link like /?ref=alice.near gives the
# visitor a discount on Zcan's fee and pays the referrer part of it on-chain through 1Click appFees.
# Shares of Zcan's fee, 0–1. Defaults: 20% off for the visitor, 20% to the referrer.
# ZCAN_REFERRAL_DISCOUNT=0.2
# ZCAN_REFERRAL_SHARE=0.2

# Content Security Policy: the full allowlist runs report-only (violations → /api/csp-report → GET /api/errors).
# Set to 1 to enforce it once reports are clean (see docs/security-review-2026-10.md, ZS-18).
# CSP_ENFORCE=1
